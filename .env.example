# Copy to .env (git-ignored). Never commit .env or devices.json.
#
# Preferred source of credentials is devices.json produced by:
#     python -m tinytuya wizard
# discover.py reads devices.json automatically. Use the values below only if
# you want to override / hand-enter the gateway.

# Gateway (WG-S "Gateway PRO X2") — local control
TUYA_GATEWAY_ID=
TUYA_GATEWAY_IP=
TUYA_GATEWAY_LOCAL_KEY=
# 3.3, 3.4 or 3.5. Leave empty to let discover.py try them in order.
TUYA_GATEWAY_VERSION=
